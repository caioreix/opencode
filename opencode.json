{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@warp-dot-dev/opencode-warp",
    "./plugins/caveman/plugin.js",
    "@tarquinen/opencode-dcp@latest"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "pencil": {
      "command": [
        "c:\\Users\\caio_\\.vscode\\extensions\\highagency.pencildev-0.6.61\\out\\mcp-server-windows-x64.exe",
        "--app",
        "visual_studio_code",
        "--agent",
        "openCodeCLI"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}